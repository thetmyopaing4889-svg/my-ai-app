modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AI Architect"

[[workflows.workflow]]
name = "AI Architect"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd my-ai-app && uv run --with flask==3.1.3 --with flask-cors==6.0.5 --with gunicorn==26.0.0 --with openai==2.52.1 --with google-genai==2.16.0 --with requests==2.34.2 gunicorn --bind 0.0.0.0:${PORT:-5000} --workers 1 --threads 8 --timeout 240 app:app"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
